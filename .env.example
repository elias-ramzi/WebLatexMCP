# Overleaf MCP server configuration.
# Copy to `.env` for local development (the real `.env` is gitignored and never committed).
# In Claude Desktop / Claude Code, set these via the server's `env` block instead.

# Overleaf git authentication token. Used as the HTTPS password (username is ignored/"git").
# NEVER commit a real token. Leave unset to fall back to the macOS Keychain (see README).
OVERLEAF_GIT_TOKEN=

# Where project clones live. One subdirectory per project id.
# Default: ~/.overleaf-mcp/projects
OVERLEAF_MCP_WORKSPACE=

# Project registry: JSON mapping a friendly id -> { gitUrl, rootFile? }.
# Example: {"thesis":{"gitUrl":"https://git.overleaf.com/0123456789abcdef"}}
OVERLEAF_MCP_PROJECTS=

# Default project id used when a tool call omits `project`.
OVERLEAF_MCP_DEFAULT_PROJECT=
