# WebLatexMCP configuration.
# Copy to `.env` for local development (the real `.env` is gitignored and never committed).
# In Claude Desktop / Claude Code, set these via the server's `env` block instead.

# Project registry: JSON map of id -> { gitUrl, rootFile?, branch?, username?, tokenEnv? }.
# Example (one Overleaf + one GitHub project):
# {"thesis":{"gitUrl":"https://git.overleaf.com/0123456789abcdef"},
#  "paper":{"gitUrl":"https://github.com/me/paper","branch":"main"}}
WEB_LATEX_MCP_PROJECTS=

# Where project clones live. One subdirectory per project id.
# Default: ~/.web-latex-mcp/projects
WEB_LATEX_MCP_WORKSPACE=

# Default project id used when a tool call omits `project`.
WEB_LATEX_MCP_DEFAULT_PROJECT=

# Compatibility workaround: set to `1` to omit `outputSchema`/`structuredContent` from tool
# results. Some Claude Desktop builds silently drop tool calls to servers that advertise an
# output schema; this makes every call fail with a generic error. Off by default. See
# docs/configuration.md#claude-desktop-compatibility.
WEB_LATEX_MCP_NO_OUTPUT_SCHEMA=

# Commit identity used by the server. Default: WebLatexMCP <web-latex-mcp@localhost>
WEB_LATEX_MCP_AUTHOR_NAME=
WEB_LATEX_MCP_AUTHOR_EMAIL=

# --- Tokens (resolved per remote host; never committed) ---------------------
# Tokens are used as the HTTPS password. Set whichever hosts you use.
# A project may override with its own `tokenEnv` (the name of an env var).
# If none is set: the GitHub CLI (`gh auth token`, when authenticated) then your OS git
# credential helper (`git credential fill`: osxkeychain / libsecret / Credential Manager) are tried.

# GitHub personal access token (host github.com). Username defaults to x-access-token.
GITHUB_TOKEN=

# Overleaf git authentication token (host git.overleaf.com). Username defaults to git.
OVERLEAF_GIT_TOKEN=

# GitLab token (host gitlab.com). Username defaults to oauth2.
GITLAB_TOKEN=

# Generic fallback token for any other host.
WEB_LATEX_MCP_TOKEN=
