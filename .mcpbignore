# Files excluded from the packed .mcpb bundle. The bundle ships the built server (dist/),
# production node_modules, the skills, and the two runtime guides — not the sources or dev tooling.
#
# Every one of these is OUR directory, so every one is anchored with a leading slash. Unanchored,
# a pattern like `src/` matches a directory of that name at ANY depth — including
# `node_modules/debug/src/`, which is where that package's `main` points. Stripping it removed the
# entry point from a runtime dependency of simple-git, and the packed server died on startup with
# "Cannot find package .../debug/src/index.js" before it could serve a single request.
/.git/
/.github/
/src/
/test/
/coverage/
/.vscode/
/.web_latex_mcp/
/.sessions/

# Dev config / build inputs (the built output in dist/ is what runs)
tsconfig*.json
vitest.config.ts
eslint.config.*
.prettier*
.editorconfig
/.plugin-scanner.toml
.gitignore
.npmrc
*.tsbuildinfo

# Never nest a previous bundle inside a new one
*.mcpb
.mcpbignore

# Local, machine-specific MCP config (also git-ignored)
.mcp.json

# --- Trim runtime-unused weight from bundled dependencies ---
# Source maps and TypeScript declarations are dev-only; nothing loads them at runtime.
*.map
*.d.ts
*.d.mts
*.d.cts

# pdf.js is used twice. The live PDF viewer serves build/, web/, cmaps/, wasm/ and
# standard_fonts/ to the browser; and the server itself imports the LEGACY build in Node —
# legacy/build/pdf.mjs, which loads legacy/build/pdf.worker.mjs beside itself — for compile's
# pageCount, /PageLabels, extract_text, pdf_geometry and render_pages. So legacy/build/ must ship:
# 0.7.0 excluded all of legacy/ and every PDF tool in the extension died on "Cannot find module
# …pdf.mjs" (test/unit/mcpbignore.test.ts pins it now). What neither user loads is the legacy
# viewer and the image-decoder entries, plus the type defs.
node_modules/pdfjs-dist/legacy/web/
node_modules/pdfjs-dist/legacy/image_decoders/
node_modules/pdfjs-dist/types/
node_modules/pdfjs-dist/image_decoders/

# pdf.js's OPTIONAL Node-side canvas renderer (@napi-rs/canvas) — a ~32 MB per-platform native
# binary. The bundle is built once, on ubuntu, for every platform, so the binary would be the wrong
# one on macOS and Windows anyway; leaving it out saves ~33 MB. Only RASTERIZING needs it, so in
# the extension render_pages refuses, naming this case, while pageCount, /PageLabels, extract_text
# and pdf_geometry work: without the backend the server supplies the one DOM global
# (`DOMMatrix`) pdf.js needs merely to be imported (src/services/pdfRender.ts).
node_modules/@napi-rs/
